    <!-- HTTPS Wizard Strings -->
    <string name="https_wizard_title">Cài đặt Chứng chỉ</string>
    <string name="https_wizard_step_indicator_format">Bước %1$d/%2$d: %3$s</string>
    <string name="https_wizard_security_title">Bảo mật &amp; Quyền riêng tư</string>
    <string name="https_wizard_security_desc">Chứng chỉ Root CA được tạo cục bộ ngay trên thiết bị của bạn và không bao giờ rời khỏi máy. BlockAds sử dụng nó để loại bỏ quảng cáo trên các trang web. Các dịch vụ nhạy cảm như ứng dụng ngân hàng và tài khoản Google hoàn toàn không bị can thiệp.</string>
    <string name="https_wizard_explain_title">Tại sao cần lọc HTTPS?</string>
    <string name="https_wizard_explain_desc">Hầu hết các trang web và quảng cáo hiện nay đều sử dụng kết nối HTTPS đã mã hóa. Để ẩn các khung quảng cáo, banner và popup phiền toái, BlockAds cần một chứng chỉ cục bộ để xử lý và lọc các trang web một cách an toàn trên máy bạn.</string>
    <string name="https_wizard_benefits_title">Lợi ích khi kích hoạt</string>
    <string name="https_wizard_benefit_1">Chặn sạch quảng cáo trên các trang video &amp; báo chí</string>
    <string name="https_wizard_benefit_2">Ẩn hoàn toàn khung trống, banner và pop-up phiền toái</string>
    <string name="https_wizard_benefit_3">Thực thi Scriptlets chặn các chiêu trò chống chặn quảng cáo</string>
    <string name="https_wizard_privacy_on_device_title" formatted="false">100% Cục bộ trên máy</string>
    <string name="https_wizard_privacy_on_device_desc">Khóa bảo mật và chứng chỉ được tạo ngẫu nhiên trên thiết bị của bạn, không bao giờ gửi ra ngoài mạng.</string>
    <string name="https_wizard_privacy_bypass_title">Bỏ qua ứng dụng Ngân hàng &amp; Tài chính</string>
    <string name="https_wizard_privacy_bypass_desc">Các tên miền nhạy cảm (ngân hàng, thanh toán, Google) luôn được chuyển tiếp trực tiếp và không bao giờ bị giải mã.</string>
    <string name="https_wizard_privacy_browser_title">Chỉ lọc các trình duyệt được cấp phép</string>
    <string name="https_wizard_privacy_browser_desc">Bạn có toàn quyền chọn hoặc bỏ chọn trình duyệt nào được áp dụng bộ lọc HTTPS.</string>
    <string name="https_wizard_cert_file_type">Chứng chỉ X.509 CA (.crt)</string>
    <string name="https_wizard_cert_status_exported">Đã lưu</string>
    <string name="https_wizard_cert_status_not_exported">Sẵn sàng</string>
    <string name="https_wizard_cert_save_note">Tệp sẽ được lưu vào thư mục Tải về (Downloads) của máy. Ở bước tiếp theo, bạn sẽ cài đặt tệp này vào hệ thống.</string>
    <string name="https_wizard_device_brand_format">Thiết bị nhận diện: %1$s</string>
    <string name="https_wizard_device_brand_generic">Thiết bị Android của bạn</string>
    <string name="https_wizard_install_instructions_title">Các bước thực hiện</string>
    <string name="https_wizard_checking_title">Đang kiểm tra chứng chỉ…</string>
    <string name="https_wizard_checking_desc">Đang quét kho chứng chỉ tin cậy của Android…</string>
    <string name="https_wizard_installed_desc">Chứng chỉ BlockAds Root CA đã được phát hiện trong kho tin cậy của thiết bị. Lọc HTTPS đã sẵn sàng hoạt động!</string>
    <string name="https_wizard_not_installed_title">Chưa phát hiện chứng chỉ</string>
    <string name="https_wizard_not_installed_desc">BlockAds chưa tìm thấy chứng chỉ trong kho chứng chỉ CA của máy. Nếu bạn vừa hoàn tất cài đặt trong Cài đặt, hãy bấm Kiểm tra lại.</string>
    <string name="https_wizard_troubleshooting_title">Mẹo khắc phục sự cố</string>
