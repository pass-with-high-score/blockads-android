    <string name="https_wizard_step_indicator_format">Schritt %1$d von %2$d: %3$s</string>
    <string name="https_wizard_overview_title">Übersicht &amp; Datenschutz</string>
    <string name="https_wizard_overview_subtitle">Warum BlockAds ein lokales Zertifikat benötigt</string>
    <string name="https_wizard_security_title">Sicherheit &amp; Datenschutz</string>
    <string name="https_wizard_security_desc">Das Root-CA-Zertifikat wird lokal auf Ihrem Gerät generiert und verlässt Ihr Telefon nie. BlockAds verwendet es ausschließlich, um Werbung auf Websites zu entfernen. Sensible Dienste wie Bank-Apps und Google-Konten werden niemals abgefangen.</string>
    <string name="https_wizard_explain_title">Warum HTTPS-Filterung?</string>
    <string name="https_wizard_explain_desc">Die meisten modernen Websites und Anzeigen verwenden verschlüsselte HTTPS-Verbindungen. Um Werbeplatzhalter, Banner und Popups auszublenden, benötigt BlockAds ein lokales Zertifikat, um Webseiten sicher auf Ihrem Gerät zu prüfen und zu filtern.</string>
    <string name="https_wizard_benefits_title">Hauptvorteile</string>
    <string name="https_wizard_benefit_1">Beseitigung von Werbung auf Videoplattformen und Nachrichtenseiten</string>
    <string name="https_wizard_benefit_2">Leere Platzhalter, Banner und aufdringliche Popups ausblenden</string>
    <string name="https_wizard_benefit_3">Scriptlets ausführen, um Anti-Adblock-Mechanismen zu umgehen</string>
    <string name="https_wizard_privacy_title">Strikte Datenschutzgarantien</string>
    <string name="https_wizard_privacy_on_device_title" formatted="false">100% auf dem Gerät</string>
    <string name="https_wizard_privacy_on_device_desc">Schlüssel und Zertifikat werden lokal auf Ihrem Telefon generiert und nirgendwohin übertragen.</string>
    <string name="https_wizard_privacy_bypass_title">Umgeht Bank- und Finanz-Apps</string>
    <string name="https_wizard_privacy_bypass_desc">Sensible Domänen (Banken, Identifikation, Google) werden direkt weitergeleitet und niemals entschlüsselt.</string>
    <string name="https_wizard_privacy_browser_title">Kontrollierter Browserbereich</string>
    <string name="https_wizard_privacy_browser_desc">Sie haben die volle Kontrolle darüber, welche Browser HTTPS-Filterung verwenden, und können diese jederzeit deaktivieren.</string>
