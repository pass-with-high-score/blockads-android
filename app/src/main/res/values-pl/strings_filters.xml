    <string name="https_filtering_root_install_desc">Automatycznie zainstaluj certyfikat CA w magazynie systemowym (wymaga Root).</string>
    <string name="https_wizard_title">Konfiguracja certyfikatu</string>
    <string name="https_wizard_step_indicator_format">Krok %1$d z %2$d: %3$s</string>
    <string name="https_wizard_overview_title">Przegląd i prywatność</string>
    <string name="https_wizard_overview_subtitle">Dlaczego BlockAds potrzebuje lokalnego certyfikatu</string>
    <string name="https_wizard_security_title">Bezpieczeństwo i prywatność</string>
    <string name="https_wizard_security_desc">Certyfikat Root CA jest generowany lokalnie na urządzeniu i nigdy go nie opuszcza. BlockAds używa go wyłącznie do usuwania reklam na stronach internetowych. Wrażliwe usługi, takie jak aplikacje bankowe i konta Google, nigdy nie są przechwytywane.</string>
    <string name="https_wizard_explain_title">Dlaczego filtrowanie HTTPS?</string>
    <string name="https_wizard_explain_desc">Większość nowoczesnych stron i reklam korzysta z szyfrowanych połączeń HTTPS. Aby ukryć puste miejsca po reklamach, banery i wyskakujące okienka, BlockAds wymaga lokalnego certyfikatu do bezpiecznego sprawdzania i filtrowania stron na Twoim urządzeniu.</string>
    <string name="https_wizard_benefits_title">Kluczowe korzyści</string>
    <string name="https_wizard_benefit_1">Wyeliminuj reklamy na platformach wideo i stronach z wiadomościami</string>
    <string name="https_wizard_benefit_2">Ukryj puste miejsca, banery i natrętne wyskakujące okienka</string>
    <string name="https_wizard_benefit_3">Uruchamiaj skryptlety, aby ominąć mechanizmy anty-adblock</string>
    <string name="https_wizard_privacy_title">Ścisłe gwarancje prywatności</string>
    <string name="https_wizard_privacy_on_device_title" formatted="false">100% na urządzeniu</string>
    <string name="https_wizard_privacy_on_device_desc">Klucze i certyfikat są generowane lokalnie w telefonie i nigdy nie są nigdzie przesyłane.</string>
    <string name="https_wizard_privacy_bypass_title">Pomija aplikacje bankowe i finansowe</string>
    <string name="https_wizard_privacy_bypass_desc">Wrażliwe domeny (banki, identyfikacja, Google) są przekazywane bezpośrednio i nigdy nie są odszyfrowywane.</string>
    <string name="https_wizard_privacy_browser_title">Kontrolowany zakres przeglądarek</string>
    <string name="https_wizard_privacy_browser_desc">Masz pełną kontrolę nad tym, które przeglądarki korzystają z filtrowania HTTPS i możesz je wyłączyć w dowolnym momencie.</string>
