    <string name="https_wizard_root_detected_title">Wykryto dostęp Root (zalecane)</string>
    <string name="https_wizard_root_detected_desc">Twoje urządzenie posiada dostęp do roota. Możesz zainstalować certyfikat CA automatycznie bez ręcznej konfiguracji.</string>
    <string name="https_wizard_checking_title">Weryfikowanie certyfikatu…</string>
