    <string name="https_wizard_troubleshooting_title">Conseils de dépannage</string>
    <string name="https_wizard_troubleshooting_tip1">Assurez-vous d\'avoir sélectionné « Certificat CA » dans les Paramètres (et non Certificat utilisateur ou VPN et certificat utilisateur d\'application).</string>
