    <string name="https_wizard_installed_desc">BlockAds Root CA is verified and active in your device\'s trust store. Advanced HTTPS filtering is ready to go!</string>
    <string name="https_wizard_not_installed_title">Certificate Not Detected</string>
    <string name="https_wizard_not_installed_desc">BlockAds has not found the certificate in your trust store yet. If you just finished installing it in Settings, tap below to check again.</string>
    <string name="https_wizard_troubleshooting_title">Troubleshooting Tips</string>
    <string name="https_wizard_troubleshooting_tip1">Make sure you selected \"CA Certificate\" in Settings (not User Certificate or VPN &amp; app user certificate).</string>
    <string name="https_wizard_troubleshooting_tip2">If installing via Magisk/KernelSU module, a device reboot is required.</string>
    <string name="https_wizard_troubleshooting_tip3">Check that the certificate file was downloaded correctly into your Downloads folder.</string>
