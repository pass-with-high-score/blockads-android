    <!-- HTTPS Wizard Strings -->
    <string name="https_wizard_title">Configuration du certificat</string>
    <string name="https_wizard_step_indicator_format">Étape %1$d sur %2$d : %3$s</string>
    <string name="https_wizard_security_title">Sécurité &amp; Confidentialité</string>
    <string name="https_wizard_security_desc">Le certificat racine CA est généré localement sur votre appareil et ne quitte jamais votre téléphone. BlockAds l\'utilise strictement pour supprimer les publicités esthétiques sur les sites web. Les services sensibles tels que les applications bancaires et les comptes Google ne sont jamais interceptés.</string>
    <string name="https_wizard_explain_title">Pourquoi le filtrage HTTPS ?</string>
    <string name="https_wizard_explain_desc">La plupart des sites web et publicités modernes utilisent des connexions chiffrées HTTPS. Pour masquer les emplacements réservés aux pubs, les bannières et les popups flottantes, BlockAds nécessite un certificat local afin d\'inspecter et filtrer les pages web en toute sécurité sur votre appareil.</string>
    <string name="https_wizard_benefits_title">Principaux avantages</string>
    <string name="https_wizard_benefit_1">Éliminer les publicités sur les plateformes vidéo &amp; sites d\'actualités</string>
    <string name="https_wizard_benefit_2">Masquer les espaces vides, les bannières et les popups intrusives</string>
    <string name="https_wizard_benefit_3">Exécuter des Scriptlets pour contourner les mécanismes anti-adblock</string>
    <string name="https_wizard_privacy_on_device_title" formatted="false">100% sur l\'appareil</string>
    <string name="https_wizard_privacy_on_device_desc">Les clés et le certificat sont générés localement sur votre téléphone et ne sont jamais transmis ailleurs.</string>
    <string name="https_wizard_privacy_bypass_title">Contourne les applications bancaires &amp; financières</string>
    <string name="https_wizard_privacy_bypass_desc">Les domaines sensibles (banques, identification, Google) sont directement retransmis et ne sont jamais déchiffrés.</string>
    <string name="https_wizard_privacy_browser_title">Périmètre restreint aux navigateurs</string>
    <string name="https_wizard_privacy_browser_desc">Vous gardez un contrôle total sur les navigateurs qui utilisent le filtrage HTTPS et pouvez le désactiver à tout moment.</string>
    <string name="https_wizard_cert_file_type">Certificat CA X.509 (.crt)</string>
    <string name="https_wizard_cert_status_exported">Enregistré</string>
    <string name="https_wizard_cert_status_not_exported">Prêt</string>
    <string name="https_wizard_cert_save_note">Le fichier de certificat sera enregistré dans le dossier Téléchargements de votre appareil. Vous l\'installerez à l\'étape suivante.</string>
