    <string name="https_filtering_explain_title">How does this work?</string>
    <string name="https_filtering_explain_body">HTTPS Filtering intercepts web traffic from your selected browsers and applies cosmetic CSS rules to hide ad banners, overlays, and other visual ad elements on web pages.\n\nTo do this, a local Root CA certificate must be installed on your device. This certificate is generated locally and never leaves your phone. Banking apps, Google, and other sensitive services are never intercepted.</string>
    <string name="https_filtering_ca_title">Setup Guide</string>
    <string name="https_filtering_ca_desc">Follow these steps to set up HTTPS cosmetic filtering:</string>
    <string name="https_filtering_export_ca">Save to Downloads</string>
    <string name="https_filtering_cert_saved">Certificate saved to Downloads!</string>
    <string name="https_filtering_install_steps">1. Go to Settings → Security → Encryption &amp; credentials\n2. Tap \&quot;Install a certificate\&quot; → \&quot;CA certificate\&quot;\n3. Select \&quot;BlockAds-RootCA.crt\&quot; from Downloads\n4. Confirm the installation</string>
    <string name="https_filtering_open_settings">Open Security Settings</string>
    <string name="https_filtering_browser_section">Browser Selection</string>
    <string name="https_filtering_browser_desc">Select browsers to apply cosmetic ad filtering. Only selected apps are filtered.</string>
    <string name="https_filtering_http3_title">Filter HTTP/3 (QUIC)</string>
    <string name="https_filtering_http3_desc">Block browser QUIC to force filterable connections for maximum ad filtering. May cause some pages to load partially. Turn off if pages don\'t load fully.</string>
    <string name="https_filtering_settings_desc">Hide ads visually in browsers</string>
