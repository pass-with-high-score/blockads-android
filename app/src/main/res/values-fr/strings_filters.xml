    <!-- HTTPS Wizard Strings -->
    <string name="https_wizard_title">Certificate Setup</string>
    <string name="https_wizard_step_indicator_format">Step %1$d of %2$d: %3$s</string>
    <string name="https_wizard_security_title">Security &amp; Privacy</string>
    <string name="https_wizard_security_desc">The Root CA certificate is generated locally on your device and never leaves your phone. BlockAds uses it strictly to remove cosmetic ads on websites. Sensitive services such as banking apps and Google accounts are never intercepted.</string>
    <string name="https_wizard_explain_title">Why HTTPS Filtering?</string>
    <string name="https_wizard_explain_desc">Most modern websites and ads use encrypted HTTPS connections. To hide visual ad placeholders, banners, and floating popups, BlockAds requires a local certificate to inspect and filter web pages safely on your device.</string>
    <string name="https_wizard_benefits_title">Key Benefits</string>
    <string name="https_wizard_benefit_1">Eliminate ads on video platforms &amp; news websites</string>
    <string name="https_wizard_benefit_2">Hide blank placeholders, banners, and intrusive popups</string>
    <string name="https_wizard_benefit_3">Execute Scriptlets to defeat anti-adblock mechanisms</string>
    <string name="https_wizard_privacy_on_device_title" formatted="false">100% On-Device</string>
    <string name="https_wizard_privacy_on_device_desc">Keys and certificate are generated locally on your phone and never transmitted anywhere.</string>
    <string name="https_wizard_privacy_bypass_title">Bypasses Banking &amp; Financial Apps</string>
    <string name="https_wizard_privacy_bypass_desc">Sensitive domains (banks, identification, Google) are directly forwarded and never decrypted.</string>
    <string name="https_wizard_privacy_browser_title">Controlled Browser Scope</string>
    <string name="https_wizard_privacy_browser_desc">You have full control over which browsers use HTTPS filtering, and can disable it anytime.</string>
    <string name="https_wizard_cert_file_type">X.509 CA Certificate (.crt)</string>
    <string name="https_wizard_cert_status_exported">Saved</string>
    <string name="https_wizard_cert_status_not_exported">Ready</string>
    <string name="https_wizard_cert_save_note">The certificate file will be saved in your device\'s Downloads folder. You will install it in the next step.</string>
