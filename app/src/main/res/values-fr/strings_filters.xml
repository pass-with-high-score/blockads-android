    <string name="https_wizard_checking_title">Vérification du certificat…</string>
    <string name="https_wizard_checking_desc">Analyse du magasin de confiance Android pour trouver le CA de BlockAds…</string>
    <string name="https_wizard_installed_desc">Le CA racine de BlockAds est vérifié et actif dans le magasin de confiance de votre appareil. Le filtrage HTTPS avancé est prêt à l'emploi !</string>
    <string name="https_wizard_not_installed_title">Certificat non détecté</string>
    <string name="https_wizard_not_installed_desc">BlockAds n'a pas encore trouvé le certificat dans votre magasin de confiance. Si vous venez de terminer son installation dans les Paramètres, appuyez ci-dessous pour revérifier.</string>
    <string name="https_wizard_troubleshooting_title">Conseils de dépannage</string>
    <string name="https_wizard_troubleshooting_tip1">Assurez-vous d'avoir sélectionné « Certificat CA » dans les Paramètres (et non Certificat utilisateur ou Certificat utilisateur VPN et application).</string>
