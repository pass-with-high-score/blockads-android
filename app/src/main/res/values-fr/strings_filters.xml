    <!-- HTTPS Wizard Strings -->
    <string name="https_wizard_title">Configuration du certificat</string>
    <string name="https_wizard_step_indicator_format">Étape %1$d sur %2$d : %3$s</string>
    <string name="https_wizard_security_title">Sécurité et confidentialité</string>
    <string name="https_wizard_security_desc">Le certificat CA racine est généré localement sur votre appareil et ne quitte jamais votre téléphone. BlockAds l'utilise strictement pour supprimer les publicités cosmétiques sur les sites Web. Les services sensibles tels que les applications bancaires et les comptes Google ne sont jamais interceptés.</string>
    <string name="https_wizard_explain_title">Pourquoi le filtrage HTTPS ?</string>
    <string name="https_wizard_explain_desc">La plupart des sites Web et publicités modernes utilisent des connexions HTTPS chiffrées. Pour masquer les emplacements publicitaires visuels, les bannières et les popups flottantes, BlockAds nécessite un certificat local pour inspecter et filtrer les pages Web en toute sécurité sur votre appareil.</string>
    <string name="https_wizard_benefits_title">Avantages clés</string>
    <string name="https_wizard_benefit_1">Éliminer les publicités sur les plateformes vidéo et les sites d'actualités</string>
    <string name="https_wizard_benefit_2">Masquer les espaces réservés vides, les bannières et les popups intrusives</string>
    <string name="https_wizard_benefit_3">Exécuter des scripts pour contrer les mécanismes anti-adblock</string>
    <string name="https_wizard_privacy_on_device_title" formatted="false">100 % sur l'appareil</string>
    <string name="https_wizard_privacy_on_device_desc">Les clés et le certificat sont générés localement sur votre téléphone et ne sont jamais transmis nulle part.</string>
    <string name="https_wizard_privacy_bypass_title">Ignore les applications bancaires et financières</string>
    <string name="https_wizard_privacy_bypass_desc">Les domaines sensibles (banques, identification, Google) sont directement acheminés et ne sont jamais déchiffrés.</string>
    <string name="https_wizard_privacy_browser_title">Portée de navigateur contrôlée</string>
    <string name="https_wizard_privacy_browser_desc">Vous avez un contrôle total sur les navigateurs qui utilisent le filtrage HTTPS et pouvez le désactiver à tout moment.</string>
    <string name="https_wizard_cert_file_type">Certificat CA X.509 (.crt)</string>
    <string name="https_wizard_cert_status_exported">Enregistré</string>
    <string name="https_wizard_cert_status_not_exported">Prêt</string>
    <string name="https_wizard_cert_save_note">Le fichier de certificat sera enregistré dans le dossier Téléchargements de votre appareil. Vous l'installerez à l'étape suivante.</string>
    <string name="https_wizard_device_brand_format">Appareil cible : %1$s</string>
    <string name="https_wizard_device_brand_generic">Votre appareil Android</string>
