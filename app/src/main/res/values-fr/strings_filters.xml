    <string name="add_rule_hint">Saisissez une règle DNS personnalisée :\n• Bloquer : ||example.com^ ou example.com\n• Bloquer les caractères génériques : ||*.ads.example.com^ ou *.ads.example.com\n• Autoriser : @@||example.com^\n• Commentaire : ! Ceci est un commentaire</string>
    <string name="import_rules_hint">Collez les règles (une par ligne) :</string>
