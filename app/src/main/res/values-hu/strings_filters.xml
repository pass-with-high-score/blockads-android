    <!-- HTTPS Wizard Strings -->
    <string name="https_wizard_title">Tanúsítvány beállítása</string>
    <string name="https_wizard_step_indicator_format">%1$d./%2$d. lépés: %3$s</string>
    <string name="https_wizard_security_title">Biztonság és adatvédelem</string>
    <string name="https_wizard_security_desc">A Root CA-tanúsítvány helyben, az eszközén jön létre, és soha nem hagyja el a telefonját. A BlockAds kizárólag a weboldalakon megjelenő kozmetikai reklámok eltávolítására használja. Az érzékeny szolgáltatások, például a banki alkalmazások és a Google-fiókok forgalmát soha nem fogja el.</string>
    <string name="https_wizard_explain_title">Miért HTTPS-szűrés?</string>
    <string name="https_wizard_explain_desc">A legtöbb modern weboldal és reklám titkosított HTTPS-kapcsolatot használ. A vizuális reklámhelyek, szalagok és lebegő felugró ablakok elrejtéséhez a BlockAds-nek egy helyi tanúsítványra van szüksége, hogy biztonságosan, az eszközén vizsgálhassa és szűrhesse a weboldalakat.</string>
    <string name="https_wizard_benefits_title">Főbb előnyök</string>
    <string name="https_wizard_benefit_1">Reklámok eltüntetése videóplatformokon és hírportálokon</string>
    <string name="https_wizard_benefit_2">Üres reklámhelyek, szalagok és tolakodó felugró ablakok elrejtése</string>
    <string name="https_wizard_benefit_3">Scriptletek futtatása az adblock-elleni mechanizmusok kijátszására</string>
    <string name="https_wizard_privacy_on_device_title" formatted="false">100% az eszközön</string>
    <string name="https_wizard_privacy_on_device_desc">A kulcsok és a tanúsítvány helyben, a telefonján jönnek létre, és soha nem kerülnek továbbításra.</string>
    <string name="https_wizard_privacy_bypass_title">Banki és pénzügyi alkalmazások kihagyása</string>
    <string name="https_wizard_privacy_bypass_desc">Az érzékeny domainek (bankok, azonosítás, Google) forgalma közvetlenül továbbítódik, és soha nem kerül visszafejtésre.</string>
    <string name="https_wizard_privacy_browser_title">Szabályozott böngészőkör</string>
    <string name="https_wizard_privacy_browser_desc">Teljes mértékben Ön dönti el, mely böngészők használják a HTTPS-szűrést, és bármikor kikapcsolhatja.</string>
    <string name="https_wizard_cert_file_type">X.509 CA-tanúsítvány (.crt)</string>
    <string name="https_wizard_cert_status_exported">Mentve</string>
    <string name="https_wizard_cert_status_not_exported">Kész</string>
    <string name="https_wizard_cert_save_note">A tanúsítványfájl az eszköz Letöltések mappájába kerül. A következő lépésben telepíti.</string>
    <string name="https_wizard_device_brand_format">Céleszköz: %1$s</string>
    <string name="https_wizard_device_brand_generic">Az Ön Android-eszköze</string>
    <string name="https_wizard_install_instructions_title">Lépésről lépésre</string>
    <string name="https_wizard_checking_title">Tanúsítvány ellenőrzése…</string>
    <string name="https_wizard_checking_desc">Az Android megbízható tanúsítványtárolójának átvizsgálása a BlockAds CA után…</string>
    <string name="https_wizard_installed_desc">A BlockAds Root CA ellenőrizve és aktív az eszköz megbízható tanúsítványtárolójában. A fejlett HTTPS-szűrés használatra kész!</string>
    <string name="https_wizard_not_installed_title">A tanúsítvány nem található</string>
    <string name="https_wizard_not_installed_desc">A BlockAds még nem találta meg a tanúsítványt a megbízható tárolóban. Ha épp most telepítette a Beállításokban, koppintson lent az újraellenőrzéshez.</string>
    <string name="https_wizard_troubleshooting_title">Hibaelhárítási tippek</string>
    <string name="https_wizard_troubleshooting_tip1">Győződjön meg róla, hogy a Beállításokban a \"CA-tanúsítvány\" lehetőséget választotta (nem a felhasználói tanúsítványt vagy a VPN- és alkalmazás-felhasználói tanúsítványt).</string>
    <string name="https_wizard_troubleshooting_tip2">Magisk/KernelSU modulon keresztüli telepítés esetén az eszköz újraindítása szükséges.</string>
    <string name="https_wizard_troubleshooting_tip3">Ellenőrizze, hogy a tanúsítványfájl megfelelően letöltődött-e a Letöltések mappába.</string>
