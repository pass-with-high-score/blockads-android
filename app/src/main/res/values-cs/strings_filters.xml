    <string name="https_wizard_title">Nastavení certifikátu</string>
    <string name="https_wizard_step_indicator_format">Krok %1$d z %2$d: %3$s</string>
    <string name="https_wizard_overview_title">Přehled a soukromí</string>
    <string name="https_wizard_overview_subtitle">Proč BlockAds potřebuje místní certifikát</string>
    <string name="https_wizard_security_title">Zabezpečení a soukromí</string>
    <string name="https_wizard_security_desc">Certifikát kořenové CA je generován lokálně ve vašem zařízení a nikdy neopouští váš telefon. BlockAds jej používá výhradně k odstranění reklam na webových stránkách. Citlivé služby, jako jsou bankovní aplikace a účty Google, nejsou nikdy zachyceny.</string>
    <string name="https_wizard_explain_title">Proč filtrování HTTPS?</string>
    <string name="https_wizard_explain_desc">Většina moderních webů a reklam používá šifrovaná připojení HTTPS. Ke skrytí zástupných symbolů reklam, bannerů a vyskakovacích oken vyžaduje BlockAds místní certifikát pro bezpečnou kontrolu a filtrování webových stránek ve vašem zařízení.</string>
    <string name="https_wizard_benefits_title">Klíčové výhody</string>
    <string name="https_wizard_benefit_1">Odstranění reklam na video platformách a zpravodajských webech</string>
    <string name="https_wizard_benefit_2">Skrytí prázdných zástupných symbolů, bannerů a obtěžujících vyskakovacích oken</string>
    <string name="https_wizard_benefit_3">Spouštění skriptletů k překonání mechanismů proti blokování reklam</string>
    <string name="https_wizard_privacy_title">Přísné záruky ochrany soukromí</string>
    <string name="https_wizard_privacy_on_device_title" formatted="false">100% v zařízení</string>
    <string name="https_wizard_privacy_on_device_desc">Klíče a certifikát jsou generovány lokálně v telefonu a nikdy se nikam neodesílají.</string>
    <string name="https_wizard_privacy_bypass_title">Obchází bankovní a finanční aplikace</string>
    <string name="https_wizard_privacy_bypass_desc">Citlivé domény (banky, identifikace, Google) jsou předávány přímo a nikdy nejsou dešifrovány.</string>
    <string name="https_wizard_privacy_browser_title">Řízený rozsah prohlížeče</string>
    <string name="https_wizard_privacy_browser_desc">Máte plnou kontrolu nad tím, které prohlížeče používají filtrování HTTPS, a můžete jej kdykoli zakázat.</string>
