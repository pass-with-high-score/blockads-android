    <string name="https_wizard_title">Configurazione certificato</string>
    <string name="https_wizard_step_indicator_format">Passaggio %1$d di %2$d: %3$s</string>
    <string name="https_wizard_overview_title">Panoramica e privacy</string>
    <string name="https_wizard_overview_subtitle">Perché BlockAds ha bisogno di un certificato locale</string>
    <string name="https_wizard_security_title">Sicurezza e privacy</string>
    <string name="https_wizard_security_desc">Il certificato Root CA viene generato localmente sul tuo dispositivo e non lascia mai il telefono. BlockAds lo utilizza rigorosamente per rimuovere gli annunci sui siti web. I servizi sensibili come le app bancarie e gli account Google non vengono mai intercettati.</string>
    <string name="https_wizard_explain_title">Perché il filtraggio HTTPS?</string>
    <string name="https_wizard_explain_desc">La maggior parte dei siti web e degli annunci moderni utilizza connessioni HTTPS crittografate. Per nascondere segnaposto pubblicitari, banner e popup, BlockAds richiede un certificato locale per ispezionare e filtrare le pagine web in modo sicuro sul tuo dispositivo.</string>
    <string name="https_wizard_benefits_title">Vantaggi principali</string>
    <string name="https_wizard_benefit_1">Elimina gli annunci sulle piattaforme video e sui siti di notizie</string>
    <string name="https_wizard_benefit_2">Nascondi segnaposto vuoti, banner e popup invasivi</string>
    <string name="https_wizard_benefit_3">Esegui Scriptlet per neutralizzare i meccanismi anti-adblock</string>
    <string name="https_wizard_privacy_title">Rigorose garanzie di privacy</string>
    <string name="https_wizard_privacy_on_device_title" formatted="false">100% sul dispositivo</string>
    <string name="https_wizard_privacy_on_device_desc">Le chiavi e il certificato vengono generati localmente sul telefono e non vengono mai trasmessi altrove.</string>
    <string name="https_wizard_privacy_bypass_title">Bypassa le app bancarie e finanziarie</string>
    <string name="https_wizard_privacy_bypass_desc">I domini sensibili (banche, identificazione, Google) vengono inoltrati direttamente e non decifrati mai.</string>
    <string name="https_wizard_privacy_browser_title">Ambito del browser controllato</string>
    <string name="https_wizard_privacy_browser_desc">Hai il pieno controllo su quali browser utilizzano il filtro HTTPS e puoi disabilitarlo in qualsiasi momento.</string>
