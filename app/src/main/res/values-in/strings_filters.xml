    <string name="https_wizard_title">Pengaturan Sertifikat</string>
    <string name="https_wizard_step_indicator_format">Langkah %1$d dari %2$d: %3$s</string>
    <string name="https_wizard_overview_title">Ikhtisar &amp; Privasi</string>
    <string name="https_wizard_overview_subtitle">Mengapa BlockAds memerlukan sertifikat lokal</string>
    <string name="https_wizard_security_title">Keamanan &amp; Privasi</string>
    <string name="https_wizard_security_desc">Sertifikat Root CA dibuat secara lokal di perangkat Anda dan tidak pernah meninggalkan ponsel Anda. BlockAds menggunakannya secara ketat untuk menghapus iklan di situs web. Layanan sensitif seperti aplikasi perbankan dan akun Google tidak pernah dicegat.</string>
    <string name="https_wizard_explain_title">Mengapa Pemfilteran HTTPS?</string>
    <string name="https_wizard_explain_desc">Sebagian besar situs web dan iklan modern menggunakan koneksi HTTPS terenkripsi. Untuk menyembunyikan placeholder iklan, banner, dan pop-up, BlockAds memerlukan sertifikat lokal untuk memeriksa dan memfilter halaman web dengan aman di perangkat Anda.</string>
    <string name="https_wizard_benefits_title">Manfaat Utama</string>
    <string name="https_wizard_benefit_1">Hilangkan iklan di platform video &amp; situs berita</string>
    <string name="https_wizard_benefit_2">Sembunyikan placeholder kosong, banner, dan pop-up yang mengganggu</string>
    <string name="https_wizard_benefit_3">Jalankan Scriptlet untuk mengalahkan mekanisme anti-adblock</string>
    <string name="https_wizard_privacy_title">Jaminan Privasi yang Ketat</string>
    <string name="https_wizard_privacy_on_device_title" formatted="false">100% di Perangkat</string>
    <string name="https_wizard_privacy_on_device_desc">Kunci dan sertifikat dibuat secara lokal di ponsel Anda dan tidak pernah dikirimkan ke mana pun.</string>
    <string name="https_wizard_privacy_bypass_title">Lewati Aplikasi Perbankan &amp; Keuangan</string>
    <string name="https_wizard_privacy_bypass_desc">Domain sensitif (bank, identifikasi, Google) diteruskan secara langsung dan tidak pernah didekripsi.</string>
    <string name="https_wizard_privacy_browser_title">Cakupan Browser Terkendali</string>
    <string name="https_wizard_privacy_browser_desc">Anda memiliki kendali penuh atas browser mana yang menggunakan pemfilteran HTTPS, dan dapat menonaktifkannya kapan saja.</string>
