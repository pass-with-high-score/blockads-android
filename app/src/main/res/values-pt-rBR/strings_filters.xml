    <string name="https_wizard_title">Configuração do certificado</string>
    <string name="https_wizard_step_indicator_format">Etapa %1$d de %2$d: %3$s</string>
    <string name="https_wizard_security_title">Segurança e privacidade</string>
    <string name="https_wizard_security_desc">O certificado Root CA é gerado localmente no seu dispositivo e nunca sai do seu telefone. O BlockAds o utiliza estritamente para remover anúncios em sites. Serviços confidenciais, como aplicativos bancários e contas do Google, nunca são interceptados.</string>
    <string name="https_wizard_explain_title">Por que a filtragem HTTPS?</string>
    <string name="https_wizard_explain_desc">A maioria dos sites e anúncios modernos usa conexões HTTPS criptografadas. Para ocultar espaços reservados de anúncios, banners e pop-ups, o BlockAds requer um certificado local para inspecionar e filtrar páginas da web com segurança no seu dispositivo.</string>
    <string name="https_wizard_benefits_title">Principais benefícios</string>
    <string name="https_wizard_benefit_1">Elimine anúncios em plataformas de vídeo e sites de notícias</string>
    <string name="https_wizard_benefit_2">Oculte espaços reservados em branco, banners e pop-ups intrusivos</string>
    <string name="https_wizard_benefit_3">Execute Scriptlets para neutralizar mecanismos antibloqueio de anúncios</string>
    <string name="https_wizard_privacy_on_device_title" formatted="false">100% no dispositivo</string>
    <string name="https_wizard_privacy_on_device_desc">As chaves e o certificado são gerados localmente no seu telefone e nunca são transmitidos.</string>
    <string name="https_wizard_privacy_bypass_title">Ignora aplicativos bancários e financeiros</string>
    <string name="https_wizard_privacy_bypass_desc">Domínios confidenciais (bancos, identificação, Google) são encaminhados diretamente e nunca descriptografados.</string>
    <string name="https_wizard_privacy_browser_title">Escopo controlado do navegador</string>
    <string name="https_wizard_privacy_browser_desc">Você tem controle total sobre quais navegadores usam a filtragem HTTPS e pode desativá-la a qualquer momento.</string>
