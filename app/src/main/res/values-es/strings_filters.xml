    <string name="https_wizard_troubleshooting_title">Consejos para solucionar problemas</string>
    <string name="https_wizard_troubleshooting_tip1">Asegúrate de haber seleccionado \"Certificado CA\" en Ajustes (no Certificado de usuario ni Certificado de VPN y aplicaciones).</string>
