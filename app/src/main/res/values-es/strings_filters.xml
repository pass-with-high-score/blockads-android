    <string name="https_wizard_step_indicator_format">Paso %1$d de %2$d: %3$s</string>
    <string name="https_wizard_overview_title">Descripción general y privacidad</string>
    <string name="https_wizard_overview_subtitle">Por qué BlockAds necesita un certificado local</string>
    <string name="https_wizard_security_title">Seguridad y privacidad</string>
    <string name="https_wizard_security_desc">El certificado Root CA se genera localmente en tu dispositivo y nunca sale de tu teléfono. BlockAds lo usa estrictamente para eliminar anuncios en sitios web. Los servicios confidenciales, como aplicaciones bancarias y cuentas de Google, nunca se interceptan.</string>
    <string name="https_wizard_explain_title">¿Por qué el filtrado HTTPS?</string>
    <string name="https_wizard_explain_desc">La mayoría de los sitios web y anuncios modernos utilizan conexiones HTTPS cifradas. Para ocultar marcadores de anuncios, banners y ventanas emergentes, BlockAds requiere un certificado local para inspeccionar y filtrar páginas web de forma segura en tu dispositivo.</string>
    <string name="https_wizard_benefits_title">Beneficios clave</string>
    <string name="https_wizard_benefit_1">Elimina anuncios en plataformas de video y sitios de noticias</string>
    <string name="https_wizard_benefit_2">Oculta marcadores en blanco, banners y ventanas emergentes intrusivas</string>
    <string name="https_wizard_benefit_3">Ejecuta Scriptlets para anular los mecanismos antibloqueo de anuncios</string>
    <string name="https_wizard_privacy_title">Estrictas garantías de privacidad</string>
    <string name="https_wizard_privacy_on_device_title" formatted="false">100% en el dispositivo</string>
    <string name="https_wizard_privacy_on_device_desc">Las claves y el certificado se generan localmente en tu teléfono y nunca se transmiten a ningún sitio.</string>
    <string name="https_wizard_privacy_bypass_title">Omite aplicaciones bancarias y financieras</string>
    <string name="https_wizard_privacy_bypass_desc">Los dominios confidenciales (bancos, identificación, Google) se reenvían directamente y nunca se descifran.</string>
    <string name="https_wizard_privacy_browser_title">Alcance controlado del navegador</string>
    <string name="https_wizard_privacy_browser_desc">Tienes control total sobre qué navegadores usan filtrado HTTPS y puedes desactivarlo en cualquier momento.</string>
